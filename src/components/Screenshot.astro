---
// A screenshot of the app, framed as the theme frames them (theme.css, .guide-screenshot),
// shown at the app's own size: a shot taken at 2x is drawn at half its pixels, so it is
// as large as the app on screen and sharp on a HiDPI display. `width` sets the shown
// width where a shot was taken at another scale.
//
//   import Screenshot from "../../../../components/Screenshot.astro";
//   import shot from "./exposure.png";
//   <Screenshot src={shot} alt="…" caption="Exposure, in the Adjust tab" />
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
}

const { src, alt, caption, width } = Astro.props;
const shown = width ?? Math.round(src.width / 2);
const height = Math.round((src.height * shown) / src.width);
---

<figure class="guide-screenshot not-content">
  <Image src={src} alt={alt} width={shown} height={height} densities={[1, 2]} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
